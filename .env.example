# Copy this file to .env and fill values. Never share .env.
BOT_TOKEN=
# MongoDB (free: https://www.mongodb.com/atlas) — all users, orders, wallet & payment history saved here
MONGODB_URI=
MONGODB_DB=averon_bot
# GlobalNexPay (https://manage.globalnexpay.site/api-setup)
GATEWAY_API_KEY=
GATEWAY_SECRET_KEY=
# Optional: public URL for instant payment webhooks (polling works without it)
GATEWAY_WEBHOOK_URL=
# Supplier APIs (Service 1)
COUPONSHOPS_API_KEY=
ACCZONE_API_KEY=
ELITE_API_KEY=
